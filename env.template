# =============================================================================
# Vito's Work Assistant — 统一环境变量模板
# 使用方法：cp env.template .env，然后填写各项值，再运行 docker compose up
# =============================================================================

# --- LLM ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# --- Portkey（Agent 访问 MCP 时附带 x-portkey-api-key header）---
PORTKEY_API_KEY=

# --- Microsoft Entra / Azure AD ---
ENTRA_TENANT_ID=
ENTRA_WORK_ASSISTANT_API_CLIENT_ID=
ENTRA_WORK_ASSISTANT_API_CLIENT_SECRET=
ENTRA_REQUIRED_SCOPE=access_as_user

# --- MCP 服务（Docker Compose 内部使用服务名寻址）---
# 本地开发时改为 http://127.0.0.1:8001/mcp
M365_MCP_URL=http://m365-mcp-http:8001/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp

# --- Web 前端（Vite 构建时内嵌，需与 Entra 注册的 SPA 配置一致）---
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_WORK_ASSISTANT_API_CLIENT_ID=
VITE_WORK_ASSISTANT_API_SCOPE=
