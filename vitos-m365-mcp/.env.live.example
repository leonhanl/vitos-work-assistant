# Public values used by scripts/verify_live.py
ENTRA_TENANT_ID=<Directory tenant ID>
ENTRA_MCP_CLIENT_ID=<vitos-m365-mcp Application client ID>
ENTRA_LIVE_TEST_CLIENT_ID=<vitos-m365-mcp-live-test public client ID>
ENTRA_REQUIRED_SCOPE=access_as_user
# Set this when the MCP app uses a custom Application ID URI.
# ENTRA_MCP_SCOPE=api://<ENTRA_MCP_CLIENT_ID>/access_as_user
MCP_RESOURCE_URL=http://127.0.0.1:8001/mcp
MCP_LIVE_TEST_QUERY=VPN
# Tested CLI baseline. Upgrade deliberately and rerun live verification.
MCP_INSPECTOR_PACKAGE=@modelcontextprotocol/inspector@2.2.0
