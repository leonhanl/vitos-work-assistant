# Streamable HTTP transport
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
MCP_RESOURCE_URL=http://127.0.0.1:8001/mcp

# Microsoft Entra app registration owned by vitos-m365-mcp
ENTRA_TENANT_ID=<Directory tenant ID>
ENTRA_MCP_CLIENT_ID=<vitos-m365-mcp Application client ID>
ENTRA_MCP_CLIENT_SECRET=<server-only secret>
ENTRA_REQUIRED_SCOPE=access_as_user
# Optional when the Application ID URI is not api://<ENTRA_MCP_CLIENT_ID>
# ENTRA_MCP_SCOPE=api://<ENTRA_MCP_CLIENT_ID>/access_as_user
