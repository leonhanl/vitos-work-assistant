# Microsoft Entra application registration (delegated authentication)
M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional. Default: ~/.cache/m365-mcp/msal_token_cache.json
# M365_TOKEN_CACHE_PATH=/absolute/path/to/msal_token_cache.json

# Streamable HTTP transport
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
