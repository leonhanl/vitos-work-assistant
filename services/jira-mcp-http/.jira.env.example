# Jira MCP 到 Atlassian JSM API 的固定 service-account 配置。
#
# 使用前请将本文件复制为 .jira.env，并替换下面的示例值。
# .jira.env 包含敏感凭据，不能提交到 Git，也不能在日志中输出其内容。
#
# 本文件只配置 Jira MCP 服务访问 Atlassian 所需的凭据。
# service_desk_id 和 raise_on_behalf_of 属于 Agent 发起 MCP 工具调用时的业务参数，
# 不应配置在这里。

# 使用 scoped service-account API token 时，必须通过 Atlassian API Gateway 访问 Jira。
# <cloud-id> 是 Atlassian Cloud 站点的 Cloud ID，不是 Organization ID。
# 格式：https://api.atlassian.com/ex/jira/<cloud-id>
JIRA_URL=https://api.atlassian.com/ex/jira/f33bf2df-109b-49e3-b6ab-c628d774a98d

# Atlassian 为专用 service account 分配的邮箱地址。
# 该账号需要拥有访问目标 JSM 服务项目、读取请求类型和代表客户创建请求的权限。
JIRA_USERNAME=jsm-mcp-integration-vgpu1023xf@serviceaccount.atlassian.com

# 为上述 service account 创建的 scoped API token。
# Token 应只包含所需的 Jira/JSM 读写 scope，并设置有效期和轮换计划。
JIRA_API_TOKEN=ATSTTxxx

# 允许 MCP 请求使用本文件中配置的全局 Jira 凭据。
# 这是当前“固定 service account”认证模型所必需的配置。
ALLOW_GLOBAL_CRED_FALLBACK=true

# 忽略 Agent 或代理传入的 Authorization header，避免将其误认为 Atlassian 用户凭据。
# Jira MCP 始终使用上面配置的 service account 访问 JSM API。
# 由于 Agent 到 MCP 没有应用层认证，必须通过本机绑定或私有网络限制 endpoint 访问。
IGNORE_HEADER_AUTH=true
