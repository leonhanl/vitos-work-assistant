# Host port exposed by the Web container. Use 80 in staging.
WEB_PORT=5173

# Host skills directory mounted read-only into the Agent container.
SKILLS_ARTIFACT_PATH=./apps/agent/skills
SKILLS_ARTIFACT_VERSION=local

# Optional red-team bridge; enable with --profile redteam.
# Publish it through your HTTPS reverse proxy for access from AIRS.
REDTEAM_PORT=8080
