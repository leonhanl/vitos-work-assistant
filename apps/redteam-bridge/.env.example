# New single-tenant Public Client app registration; enable public client flows.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000001
REDTEAM_CLIENT_ID=00000000-0000-0000-0000-000000000002
# Existing Work Assistant API registration (not the SPA or MCP client ID).
ENTRA_WORK_ASSISTANT_API_CLIENT_ID=00000000-0000-0000-0000-000000000003
# Object ID of the one test user this bridge is allowed to represent.
REDTEAM_USER_OID=00000000-0000-0000-0000-000000000004
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
REDTEAM_API_KEY=replace-with-a-random-key-at-least-32-characters

# Docker defaults. Keep the Agent as the target, so all OBO and gateway controls run.
REDTEAM_ASSISTANT_URL=http://agent:8000/chat
REDTEAM_CACHE_PATH=/data/msal_token_cache.json
REDTEAM_CONVERSATIONS_PATH=/data/conversations.sqlite3
REDTEAM_REQUEST_TIMEOUT=120
