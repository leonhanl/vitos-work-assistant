FROM node:22-slim AS build

WORKDIR /app
COPY package*.json ./
RUN npm install

# VITE_* vars must be present at build time so Vite can inline them.
ARG VITE_ENTRA_TENANT_ID
ARG VITE_ENTRA_CLIENT_ID
ARG VITE_WORK_ASSISTANT_API_CLIENT_ID
ARG VITE_WORK_ASSISTANT_API_SCOPE

ENV VITE_ENTRA_TENANT_ID=$VITE_ENTRA_TENANT_ID
ENV VITE_ENTRA_CLIENT_ID=$VITE_ENTRA_CLIENT_ID
ENV VITE_WORK_ASSISTANT_API_CLIENT_ID=$VITE_WORK_ASSISTANT_API_CLIENT_ID
ENV VITE_WORK_ASSISTANT_API_SCOPE=$VITE_WORK_ASSISTANT_API_SCOPE

COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
