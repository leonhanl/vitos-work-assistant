# The endpoint must implement OpenAI-compatible Chat Completions and tool calling.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-a-tool-calling-model

# Work Assistant API authentication (Token A)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_WORK_ASSISTANT_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_WORK_ASSISTANT_API_CLIENT_SECRET=replace-with-client-secret
ENTRA_REQUIRED_SCOPE=access_as_user

# The independently running m365-mcp-http Streamable HTTP endpoint.
M365_MCP_URL=http://127.0.0.1:8001/mcp

# Development-only interactive client (public client; no client secret)
ENTRA_TEST_CLIENT_ID=00000000-0000-0000-0000-000000000000
WORK_ASSISTANT_API_URL=http://127.0.0.1:8000
