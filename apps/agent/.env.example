# The endpoint must implement OpenAI-compatible Chat Completions and tool calling.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-a-tool-calling-model

# M365_TENANT_ID and M365_CLIENT_ID continue to come from the existing
# services/m365-mcp/.env. Optional: use a non-default cache created by login.
# M365_TOKEN_CACHE_PATH=/absolute/path/to/msal_token_cache.json

# Optional: Python executable in an environment where m365-mcp is installed.
# M365_MCP_PYTHON=/absolute/path/to/vitos-work-assistant/.venv/bin/python
