# The endpoint must implement OpenAI-compatible Chat Completions and tool calling.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-a-tool-calling-model

# Work Assistant API authentication (Token A)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_WORK_ASSISTANT_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_WORK_ASSISTANT_API_CLIENT_SECRET=replace-with-client-secret
ENTRA_REQUIRED_SCOPE=access_as_user

# The independently running vitos-m365-mcp Streamable HTTP endpoint and audience.
# Use the service's public HTTPS endpoint outside local development.
M365_MCP_URL=http://127.0.0.1:8001/mcp
ENTRA_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional when the Application ID URI is not api://<ENTRA_MCP_CLIENT_ID>
# ENTRA_MCP_SCOPE=api://<ENTRA_MCP_CLIENT_ID>/access_as_user
